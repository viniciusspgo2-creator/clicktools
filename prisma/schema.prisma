generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WhatsAppLink {
  id        String   @id @default(cuid())
  slug      String   @unique
  phone     String
  message   String   @default("")
  title     String   @default("")
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

/**
 * ---------------- Acesso PREMIUM (Mockup Studio) ----------------
 */

model AccessCode {
  id               String          @id @default(cuid())
  code             String          @unique
  note             String          @default("")
  clientName       String          @default("")
  clientType       String          @default("library")
  browserHash      String?
  sessionHash      String?
  sessionExpiresAt DateTime?
  maxUses          Int             @default(1)
  active           Boolean         @default(true)
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())
  uses             AccessCodeUse[]

  @@index([sessionHash])
}

model AccessCodeUse {
  id       String     @id @default(cuid())
  codeId   String
  code     AccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  deviceId String
  usedAt   DateTime   @default(now())

  @@unique([codeId, deviceId])
  @@index([usedAt])
}

/**
 * ---------------- Contador de visitas ----------------
 */

model Visit {
  id        String   @id @default(cuid())
  day       String // "2026-10-13" (America/Sao_Paulo)
  path      String
  sid       String // id de sessão anônima
  createdAt DateTime @default(now())

  @@index([day])
  @@index([day, path])
}

/**
 * ---------------- Configurações (SEO etc.) ----------------
 */

model SiteConfig {
  key       String   @id
  value     String // JSON serializado
  updatedAt DateTime @updatedAt
}
