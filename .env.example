# ============================================================
# Click & Gruda Tools — variáveis de ambiente
# Copie como .env na Vercel (Project → Settings → Environment Variables)
# ============================================================

# Neon PostgreSQL (obrigatório) — Project → Dashboard → Connection string
# Formato: postgresql://USUARIO:SENHA@EP-HOST.neon.tech/NEONDB?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Painel Admin (/admin) — TROQUE em produção (obrigatório na Vercel)
ADMIN_PASSWORD="sua-senha-forte-do-painel"

# Segredo de assinatura do cookie de sessão admin — use 32+ caracteres aleatórios
ADMIN_SECRET="troque-por-um-segredo-aleatorio-longo"
